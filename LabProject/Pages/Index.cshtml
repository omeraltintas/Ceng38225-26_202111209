@page
@model LabProject.Pages.IndexModel
@{
    ViewData["Title"] = "Class List";
}


<div class="row">
    <div class="col-md-6">
        <h3>@(Model.classInformationModel != null && Model.classInformationModel.Id == 0 ? "Add New Class" : "Edit Class")</h3>
        <form method="post">
            <div class="form-group">
                <label for="ClassName">Class Name</label>
                <input type="text" class="form-control" id="ClassName" 
                       name="classInformationModel.ClassName" 
                       value="@Model.classInformationModel.ClassName" required />
            </div>
      
            <div class="form-group">
                <label for="StudentCount">Student Count</label>
                <input type="number" class="form-control" id="StudentCount" 
                       name="classInformationModel.StudentCount" 
                       value="@Model.classInformationModel.StudentCount" required />
            </div>
            <div class="form-group">
                <label for="Description">Description</label>
                <textarea class="form-control" id="Description" 
                          name="classInformationModel.Description" required>@Model.classInformationModel.Description</textarea>
            </div>
            

            <button type="submit" class="btn btn-primary">
                @(Model.classInformationModel.Id == 0 ? "Add Class" : "Save Changes")
            </button>
            @if (Model.classInformationModel.Id != 0)
            {
                <a href="?" class="btn btn-secondary">Cancel</a>
            }
           
        </form>
        <br>
         <button id="exportJsonBtn" class="btn btn-success mb-2">Export JSON</button>

    </div>

    <div class="col-md-6">
        <h3>Class List</h3>
        <table class="table">
            <thead>
                <tr>
                    <th onclick="toggleColumn('Id')" class="selectable">Id</th>
                    <th onclick="toggleColumn('Class Name')" class="selectable">Class Name</th>
                    <th onclick="toggleColumn('Student Count')" class="selectable">Student Count</th>
                    <th onclick="toggleColumn('Description')" class="selectable">Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var classInfo in IndexModel.Classes)
                {
                    <tr>
                        <td>@classInfo.Id</td>
                        <td>@classInfo.ClassName</td>
                        <td>@classInfo.StudentCount</td>
                        <td>@classInfo.Description</td>
                        <td>
                            <form method="post" style="display:inline;">
                                <button type="submit" class="btn btn-warning btn-sm" name="id" value="@classInfo.Id" formaction="@Url.Page("Index", new { handler = "Edit" })">Edit</button>
                            </form>
                            <form method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm" name="id" value="@classInfo.Id" formaction="@Url.Page("Index", new { handler = "Delete" })">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    
    const selectedColumns = new Set();

    document.addEventListener("DOMContentLoaded", function () {
        const headerCells = document.querySelectorAll("table thead th");

        headerCells.forEach((cell, index) => {
            if (index === headerCells.length - 1) return; 

            cell.style.cursor = "pointer";
            cell.addEventListener("click", () => {
                if (selectedColumns.has(index)) {
                    selectedColumns.delete(index);
                    cell.style.backgroundColor = ""; 
                } else {
                    selectedColumns.add(index);
                    cell.style.backgroundColor = "#d1e7dd"; 
                }
            });
        });

        document.getElementById("exportJsonBtn").addEventListener("click", function () {
            const rows = document.querySelectorAll("table tbody tr");
            const headers = Array.from(document.querySelectorAll("table thead th")).map(h => h.innerText.trim());

            const exportData = [];

            rows.forEach(row => {
                const cells = row.querySelectorAll("td");
                const rowData = {};

                headers.forEach((header, i) => {
                    if (header === "Actions") return;

                    if (selectedColumns.size === 0 || selectedColumns.has(i)) {
                        rowData[header] = cells[i].innerText.trim();
                    }
                });

                exportData.push(rowData);
            });

            const jsonStr = JSON.stringify(exportData, null, 2);
            const blob = new Blob([jsonStr], { type: "application/json" });
            const url = URL.createObjectURL(blob);

            const link = document.createElement("a");
            link.href = url;
            link.download = "exported_data.json";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });
    });
</script>
}
